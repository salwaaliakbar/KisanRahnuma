# Copy to .env. Vite only exposes variables that start with VITE_.

# Which backend to call: "development" -> VITE_BACKEND_DEV, "production" -> VITE_BACKEND_PROD.
# Leave empty to choose automatically (npm run dev = development, npm run build = production).
VITE_APP_ENV=
VITE_BACKEND_DEV=http://localhost:8000
VITE_BACKEND_PROD=https://kisanrahnuma.onrender.com

# WhatsApp number of the chatbot, international format, digits only (e.g. 923001234567).
# Leave empty until the WhatsApp channel is live: the website's WhatsApp buttons then open the web chat.
VITE_WHATSAPP_NUMBER=
