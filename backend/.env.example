# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection (SQLAlchemy URL using the psycopg v3 driver).
# Your local PostgreSQL 18 service listens on port 5433.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/farmer_assistant

# Secret for hashing channel identifiers (browser id now, WhatsApp number later).
# Use a long random value; changing it makes existing farmers look new.
IDENTITY_HASH_SECRET=replace-with-a-long-random-string

# Allowed frontend origins, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conversation session timeout (minutes of inactivity).
SESSION_TIMEOUT_MINUTES=30

# Bot reply language. Only "en" is available in the MVP.
DEFAULT_LANGUAGE=en

# WhatsApp Business Cloud API (Meta developer app -> WhatsApp -> API Setup).
# The test access token expires after 24 hours; use a System User token for longer.
ACCESS_TOKEN=
# The phone number ID (digits), NOT the phone number itself.
PHONE_NUMBER_ID=
# Any random string; enter the same value as "Verify token" in Meta's webhook settings.
VERIFY_TOKEN=
# App settings -> Basic -> App secret. Required: unsigned webhooks are rejected.
APP_SECRET=

# Weather: open_meteo = live forecasts from Open-Meteo (free, no key; non-commercial use),
# json = fixed sample forecasts in app/data/weather.json (offline).
WEATHER_PROVIDER=open_meteo
WEATHER_CACHE_MINUTES=60

# Admin dashboard (/admin on the frontend): one shared operator password, not per-user
# accounts. Required to log in; leave unset to disable admin login entirely.
ADMIN_PASSWORD=
# Secret used to sign admin login tokens. Use a long random value.
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
# How long an admin login stays valid, in minutes.
ADMIN_TOKEN_TTL_MINUTES=720
